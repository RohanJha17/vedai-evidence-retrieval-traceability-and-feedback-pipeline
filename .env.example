# Server Port (default: 4100)
PORT=4100

# Allowed CORS origins (comma-separated, e.g. http://localhost:3000,http://localhost:5173 or leave empty for *)
CORS_ORIGINS=*

# Optional MongoDB URI (if omitted or unavailable during startup, local SQLite is initialized in data/)
MONGODB_URI=mongodb://localhost:27017/VedAI

# Optional shared API key. Set a long random value before exposing API routes beyond localhost.
API_KEY=

# Feedback and retrieval-session retention period. Expired records are removed at startup;
# MongoDB also expires them asynchronously through TTL indexes.
FEEDBACK_RETENTION_DAYS=365

# Active corpus path (research_dataset/corpus_chunks_complete.jsonl for production, or research_dataset/corpus_chunks.jsonl for 18-chunk paper baseline)
CORPUS_PATH=research_dataset/corpus_chunks_complete.jsonl
