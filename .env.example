# Server Port (default: 4100)
PORT=4100

# Allowed CORS origins (comma-separated, e.g. http://localhost:3000,http://localhost:5173 or leave empty for *)
CORS_ORIGINS=*

# Optional MongoDB URI (if omitted or unavailable, automatically falls back to local SQLite database in data/)
MONGODB_URI=mongodb://localhost:27017/VedAI

# Active corpus path (research_dataset/corpus_chunks_complete.jsonl for production, or research_dataset/corpus_chunks.jsonl for 18-chunk paper baseline)
CORPUS_PATH=research_dataset/corpus_chunks_complete.jsonl
